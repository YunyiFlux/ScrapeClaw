# ==============================================================================
# ScrapeClaw Git Ignore Configuration
# ==============================================================================

# Environment Variables & Secrets (Strictly Protected)
.env
.env.*
!.env.example
*.key
*.pem
*.token

# User Sessions & Personal Cookie Files (Strictly Protected)
*_cookies.txt
cookies.txt
github_cookies.txt
*session*.json
!tests/fixtures/**

# Python Bytecode & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Virtual Environments
venv/
env/
.venv/
ENV/

# Testing & Caches
.pytest_cache/
.coverage
htmlcov/
.tox/

# Local Output & Temp Data
output/
temp/
scratch/
scrapeclaw_workspace/
crawlers/
*.log

# Playwright Downloads & Recordings
.playwright/
test-results/

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local testing spider crawler scripts and outputs (excluded per release design)
spiders/

# Internal development design documentation (PRD, architecture, etc.)
docs/

tests/